{
  "private": true,
  "name": "trash-panda-royale",
  "version": "0.1.0",
  "description": "Trash Panda Royale: a chibi-raccoon battle royale mini-GTA (Colyseus 0.18 + PixiJS 3D)",
  "type": "module",
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build --mode client --outDir dist",
    "build:full": "vite build",
    "start:prod": "node -e \"process.env.NODE_ENV='production'; import('./dist/server/server.mjs')\"",
    "test": "mocha -r tsx test/**.test.ts --exit --timeout 30000",
    "assets": "node assets-src/build-assets.mjs",
    "loadtest": "tsx loadtest/bots.ts --room town --numClients 6",
    "bots": "tsx loadtest/royale.ts",
    "clean": "rimraf dist"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@colyseus/loadtest": "^0.18.1",
    "@colyseus/sdk": "^0.18.1",
    "@colyseus/testing": "^0.18.5",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.1",
    "@types/node": "^22.13.13",
    "meshoptimizer": "^1.3.0",
    "mocha": "^11.7.5",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@colyseus/playground": "^0.18.3",
    "@colyseus/schema": "^5.0.14",
    "@colyseus/tools": "^0.18.1",
    "@colyseus/uwebsockets-transport": "^0.18.4",
    "@pixi/3d": "^0.1.0",
    "colyseus": "^0.18.2",
    "express": "^5.2.1",
    "pixi.js": "^8.23.0",
    "uwebsockets-express": "^2.0.4"
  }
}
